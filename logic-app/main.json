{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "18224475928029415109"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "logicAppName": {
      "type": "string",
      "metadata": {
        "description": "Name for the Logic App resource"
      }
    },
    "mailboxAddress": {
      "type": "string",
      "metadata": {
        "description": "Outlook mailbox email address to monitor"
      }
    },
    "inboxApiUrl": {
      "type": "string",
      "defaultValue": "https://inbox.factoriq.ai",
      "metadata": {
        "description": "factoriq.ai API base URL (must be HTTPS)"
      }
    },
    "inboxApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "factoriq.ai API key (idpe_ prefix)"
      }
    },
    "documentType": {
      "type": "string",
      "defaultValue": "order",
      "allowedValues": [
        "order",
        "invoice",
        "data_sheet",
        "delivery_note"
      ],
      "metadata": {
        "description": "Document type for extraction"
      }
    }
  },
  "variables": {
    "office365ConnectionName": "[format('{0}-office365', parameters('logicAppName'))]",
    "office365ConnectionDisplayName": "[format('Outlook - {0}', parameters('mailboxAddress'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('office365ConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
        },
        "displayName": "[variables('office365ConnectionDisplayName')]"
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "tags": {
        "purpose": "email-to-extraction",
        "managed-by": "factoriq-integrations"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "inboxApiUrl": {
              "type": "String",
              "defaultValue": ""
            },
            "inboxApiKey": {
              "type": "SecureString",
              "defaultValue": ""
            },
            "documentType": {
              "type": "String",
              "defaultValue": "order"
            }
          },
          "triggers": {
            "When_a_new_email_arrives": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/v2/Mail/OnNewEmail",
                "queries": {
                  "folderId": "Inbox",
                  "importance": "Any",
                  "fetchOnlyWithAttachment": true,
                  "includeAttachments": true
                }
              },
              "recurrence": {
                "frequency": "Minute",
                "interval": 3
              },
              "splitOn": "@triggerBody()?['value']"
            }
          },
          "actions": {
            "Check_has_attachments": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(triggerBody()?['Attachments'])",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "For_each_attachment": {
                  "type": "Foreach",
                  "foreach": "@triggerBody()?['Attachments']",
                  "actions": {
                    "Check_is_PDF": {
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@items('For_each_attachment')?['ContentType']",
                              "application/pdf"
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Try_process_attachment": {
                          "type": "Scope",
                          "actions": {
                            "Upload_document": {
                              "type": "Http",
                              "inputs": {
                                "method": "POST",
                                "uri": "@{parameters('inboxApiUrl')}/api/documents/upload",
                                "headers": {
                                  "Authorization": "Bearer @{parameters('inboxApiKey')}"
                                },
                                "body": {
                                  "$content-type": "multipart/form-data",
                                  "$multipart": [
                                    {
                                      "headers": {
                                        "Content-Disposition": "form-data; name=\"file\"; filename=\"@{items('For_each_attachment')?['Name']}\""
                                      },
                                      "body": "@base64ToBinary(items('For_each_attachment')?['ContentBytes'])"
                                    },
                                    {
                                      "headers": {
                                        "Content-Disposition": "form-data; name=\"document_type\""
                                      },
                                      "body": "@{parameters('documentType')}"
                                    }
                                  ]
                                },
                                "retryPolicy": {
                                  "type": "exponential",
                                  "count": 2,
                                  "interval": "PT15S",
                                  "minimumInterval": "PT10S",
                                  "maximumInterval": "PT1M"
                                }
                              },
                              "runAfter": {},
                              "runtimeConfiguration": {
                                "secureData": {
                                  "properties": [
                                    "inputs"
                                  ]
                                }
                              }
                            },
                            "Parse_upload_response": {
                              "type": "ParseJson",
                              "inputs": {
                                "content": "@body('Upload_document')",
                                "schema": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "integer"
                                    },
                                    "filename": {
                                      "type": "string"
                                    },
                                    "status": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              "runAfter": {
                                "Upload_document": [
                                  "Succeeded"
                                ]
                              }
                            },
                            "Trigger_extraction": {
                              "type": "Http",
                              "inputs": {
                                "method": "POST",
                                "uri": "@{parameters('inboxApiUrl')}/api/documents/@{body('Parse_upload_response')?['id']}/extract",
                                "headers": {
                                  "Authorization": "Bearer @{parameters('inboxApiKey')}"
                                },
                                "retryPolicy": {
                                  "type": "exponential",
                                  "count": 2,
                                  "interval": "PT15S",
                                  "minimumInterval": "PT10S",
                                  "maximumInterval": "PT1M"
                                }
                              },
                              "runAfter": {
                                "Parse_upload_response": [
                                  "Succeeded"
                                ]
                              },
                              "runtimeConfiguration": {
                                "secureData": {
                                  "properties": [
                                    "inputs"
                                  ]
                                }
                              }
                            }
                          },
                          "runAfter": {}
                        },
                        "Catch_processing_error": {
                          "type": "Scope",
                          "actions": {
                            "Log_error": {
                              "type": "Compose",
                              "inputs": {
                                "message": "Failed to process PDF attachment",
                                "attachment": "@items('For_each_attachment')?['Name']",
                                "error": "@result('Try_process_attachment')",
                                "timestamp": "@utcNow()"
                              },
                              "runAfter": {}
                            }
                          },
                          "runAfter": {
                            "Try_process_attachment": [
                              "Failed",
                              "TimedOut"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "runAfter": {}
                    }
                  },
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]",
                "connectionName": "[variables('office365ConnectionName')]"
              }
            }
          },
          "inboxApiUrl": {
            "value": "[parameters('inboxApiUrl')]"
          },
          "inboxApiKey": {
            "value": "[parameters('inboxApiKey')]"
          },
          "documentType": {
            "value": "[parameters('documentType')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]"
      ]
    }
  ],
  "outputs": {
    "logicAppId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "office365ConnectionName": {
      "type": "string",
      "value": "[variables('office365ConnectionName')]"
    }
  }
}