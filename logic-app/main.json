{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "15645558954264609943"
    }
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "metadata": {
        "description": "Name for the Logic App resource"
      }
    },
    "mailboxAddress": {
      "type": "string",
      "metadata": {
        "description": "Outlook mailbox email address to monitor"
      }
    },
    "inboxApiUrl": {
      "type": "string",
      "defaultValue": "https://inbox.factoriq.ai",
      "metadata": {
        "description": "factoriq.ai API base URL (must be HTTPS)"
      }
    },
    "inboxApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "factoriq.ai API key (idpe_ prefix)"
      }
    },
    "documentType": {
      "type": "string",
      "defaultValue": "order",
      "allowedValues": [
        "order",
        "invoice",
        "data_sheet",
        "delivery_note",
        "quote_request"
      ],
      "metadata": {
        "description": "Document type for extraction"
      }
    }
  },
  "variables": {
    "office365ConnectionName": "[format('{0}-office365', parameters('logicAppName'))]",
    "office365ConnectionDisplayName": "[format('Outlook - {0}', parameters('mailboxAddress'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('office365ConnectionName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', resourceGroup().location, 'office365')]"
        },
        "displayName": "[variables('office365ConnectionDisplayName')]"
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "purpose": "email-to-extraction",
        "managed-by": "factoriq-integrations"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "inboxApiUrl": {
              "type": "String",
              "defaultValue": ""
            },
            "inboxApiKey": {
              "type": "SecureString",
              "defaultValue": ""
            },
            "documentType": {
              "type": "String",
              "defaultValue": "order"
            }
          },
          "triggers": {
            "When_a_new_email_arrives": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/v2/Mail/OnNewEmail",
                "queries": {
                  "folderId": "Inbox",
                  "importance": "Any",
                  "fetchOnlyWithAttachment": false,
                  "includeAttachments": true
                }
              },
              "recurrence": {
                "frequency": "Minute",
                "interval": 3
              },
              "splitOn": "@triggerBody()?['value']"
            }
          },
          "actions": {
            "Filter_PDF_attachments": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(triggerBody()?['Attachments'], json('[]'))",
                "where": "@or(equals(item()?['ContentType'], 'application/pdf'), endsWith(toLower(item()?['Name']), '.pdf'))"
              },
              "runAfter": {}
            },
            "Check_has_PDF": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(body('Filter_PDF_attachments'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "For_each_PDF": {
                  "type": "Foreach",
                  "foreach": "@body('Filter_PDF_attachments')",
                  "actions": {
                    "Try_ingest_PDF": {
                      "type": "Scope",
                      "actions": {
                        "Ingest_mail_PDF": {
                          "type": "Http",
                          "inputs": {
                            "method": "POST",
                            "uri": "@{parameters('inboxApiUrl')}/api/ingest/mail",
                            "headers": {
                              "Authorization": "Bearer @{parameters('inboxApiKey')}",
                              "Content-Type": "application/json"
                            },
                            "body": {
                              "message_id": "@{triggerBody()?['Id']}/@{items('For_each_PDF')?['Id']}",
                              "sender_address": "@{triggerBody()?['From']}",
                              "subject": "@{triggerBody()?['Subject']}",
                              "received_at": "@{triggerBody()?['DateTimeReceived']}",
                              "body_content": "@{triggerBody()?['Body']}",
                              "body_content_type": "@{if(equals(triggerBody()?['IsHtml'], true), 'html', 'text')}",
                              "document_type": "@{parameters('documentType')}",
                              "attachments": [
                                {
                                  "name": "@{items('For_each_PDF')?['Name']}",
                                  "content_type": "application/pdf",
                                  "content_base64": "@{items('For_each_PDF')?['ContentBytes']}",
                                  "is_inline": false
                                }
                              ]
                            },
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 2,
                              "interval": "PT15S",
                              "minimumInterval": "PT10S",
                              "maximumInterval": "PT1M"
                            }
                          },
                          "runAfter": {},
                          "runtimeConfiguration": {
                            "secureData": {
                              "properties": [
                                "inputs"
                              ]
                            }
                          }
                        }
                      },
                      "runAfter": {}
                    },
                    "Catch_ingest_PDF": {
                      "type": "Scope",
                      "actions": {
                        "Log_ingest_PDF": {
                          "type": "Compose",
                          "inputs": {
                            "message": "Failed to send PDF attachment",
                            "attachment": "@items('For_each_PDF')?['Name']",
                            "error": "@result('Try_ingest_PDF')",
                            "timestamp": "@utcNow()"
                          },
                          "runAfter": {}
                        }
                      },
                      "runAfter": {
                        "Try_ingest_PDF": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    }
                  },
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Try_ingest_body": {
                    "type": "Scope",
                    "actions": {
                      "Ingest_mail_body": {
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "@{parameters('inboxApiUrl')}/api/ingest/mail",
                          "headers": {
                            "Authorization": "Bearer @{parameters('inboxApiKey')}",
                            "Content-Type": "application/json"
                          },
                          "body": {
                            "message_id": "@{triggerBody()?['Id']}",
                            "sender_address": "@{triggerBody()?['From']}",
                            "subject": "@{triggerBody()?['Subject']}",
                            "received_at": "@{triggerBody()?['DateTimeReceived']}",
                            "body_content": "@{triggerBody()?['Body']}",
                            "body_content_type": "@{if(equals(triggerBody()?['IsHtml'], true), 'html', 'text')}",
                            "document_type": "@{parameters('documentType')}",
                            "attachments": []
                          },
                          "retryPolicy": {
                            "type": "exponential",
                            "count": 2,
                            "interval": "PT15S",
                            "minimumInterval": "PT10S",
                            "maximumInterval": "PT1M"
                          }
                        },
                        "runAfter": {},
                        "runtimeConfiguration": {
                          "secureData": {
                            "properties": [
                              "inputs"
                            ]
                          }
                        }
                      }
                    },
                    "runAfter": {}
                  },
                  "Catch_ingest_body": {
                    "type": "Scope",
                    "actions": {
                      "Log_ingest_body": {
                        "type": "Compose",
                        "inputs": {
                          "message": "Failed to send mail body",
                          "error": "@result('Try_ingest_body')",
                          "timestamp": "@utcNow()"
                        },
                        "runAfter": {}
                      }
                    },
                    "runAfter": {
                      "Try_ingest_body": [
                        "Failed",
                        "TimedOut"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Filter_PDF_attachments": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', resourceGroup().location, 'office365')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]",
                "connectionName": "[variables('office365ConnectionName')]"
              }
            }
          },
          "inboxApiUrl": {
            "value": "[parameters('inboxApiUrl')]"
          },
          "inboxApiKey": {
            "value": "[parameters('inboxApiKey')]"
          },
          "documentType": {
            "value": "[parameters('documentType')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]"
      ]
    }
  ],
  "outputs": {
    "logicAppId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "office365ConnectionName": {
      "type": "string",
      "value": "[variables('office365ConnectionName')]"
    }
  }
}