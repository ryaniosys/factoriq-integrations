{
  "swagger": "2.0",
  "info": {
    "title": "factoriq.ai Document Processing",
    "description": "Send emails and documents to factoriq.ai and run AI-powered data extraction",
    "version": "1.2.0",
    "contact": {
      "name": "factoriq.ai Support",
      "url": "https://inbox.factoriq.ai/docs"
    }
  },
  "host": "inbox.factoriq.ai",
  "basePath": "/api",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "apiKey": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "API key authentication. Format: Bearer idpe_<your-api-key>"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/ingest/mail": {
      "post": {
        "operationId": "IngestMail",
        "summary": "Send an email to factoriq.ai",
        "description": "Send one email with its attachment. factoriq.ai stores the PDF (or the email body if there is no PDF) as a document and runs the extraction, then returns. One quota unit is charged when the extraction starts. Sending the same message_id again returns the existing document and is not charged, so this action is safe to retry.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/MailIngestRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email received (status created or duplicate)",
            "schema": {
              "$ref": "#/definitions/MailIngestResponse"
            }
          },
          "400": {
            "description": "Invalid attachment (not valid base64, unsupported type, too large, or corrupted)"
          },
          "401": {
            "description": "Invalid or expired API key"
          },
          "422": {
            "description": "Request body does not match the schema"
          },
          "429": {
            "description": "Monthly quota exceeded; nothing was stored"
          }
        }
      }
    },
    "/documents/upload": {
      "post": {
        "operationId": "UploadDocument",
        "summary": "Upload a document",
        "description": "Upload a PDF, PNG, JPEG, plain-text or HTML file. Returns a document record with an ID that is used to run extraction.",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "file",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": "File to upload: PDF, PNG, JPEG, TXT or HTML"
          },
          {
            "name": "document_type",
            "in": "formData",
            "type": "string",
            "required": false,
            "default": "order",
            "enum": [
              "order",
              "invoice",
              "data_sheet",
              "delivery_note",
              "quote_request"
            ],
            "description": "Type of document for extraction"
          }
        ],
        "responses": {
          "200": {
            "description": "Document uploaded successfully",
            "schema": {
              "$ref": "#/definitions/DocumentResponse"
            }
          },
          "400": {
            "description": "Invalid file (unsupported type, too large, or corrupted)"
          },
          "401": {
            "description": "Invalid or expired API key"
          },
          "409": {
            "description": "Duplicate document already uploaded",
            "schema": {
              "$ref": "#/definitions/DuplicateDocumentError"
            }
          },
          "429": {
            "description": "Rate limit or monthly quota exceeded"
          }
        }
      }
    },
    "/documents/{document_id}/extract": {
      "post": {
        "operationId": "TriggerExtraction",
        "summary": "Run extraction for an uploaded document",
        "description": "Run AI-powered data extraction on a previously uploaded document. The call is synchronous: it returns once the extraction is finished, with the extracted data and confidence. If extraction fails, the document is deleted so it can be uploaded again. Do not retry this action automatically.",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "type": "integer",
            "required": true,
            "description": "ID of the document to extract (from upload response)"
          }
        ],
        "responses": {
          "200": {
            "description": "Extraction finished",
            "schema": {
              "$ref": "#/definitions/ExtractionResponse"
            }
          },
          "400": {
            "description": "Document could not be read (extraction failed; the document has been deleted)"
          },
          "401": {
            "description": "Invalid or expired API key"
          },
          "404": {
            "description": "Document not found"
          },
          "429": {
            "description": "Monthly quota exceeded"
          },
          "500": {
            "description": "Extraction failed (the document has been deleted)"
          }
        }
      }
    }
  },
  "definitions": {
    "DocumentResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Document ID (use this to trigger extraction)"
        },
        "filename": {
          "type": "string",
          "description": "Server-generated filename"
        },
        "original_filename": {
          "type": "string",
          "description": "Original filename as uploaded"
        },
        "file_size": {
          "type": "integer",
          "description": "File size in bytes"
        },
        "status": {
          "type": "string",
          "description": "Document status: uploaded, processed or extraction_failed"
        },
        "document_type": {
          "type": "string",
          "description": "Document type used for extraction"
        },
        "uploaded_at": {
          "type": "string",
          "format": "date-time",
          "description": "Upload timestamp"
        },
        "content_type": {
          "type": "string",
          "description": "MIME type of the stored file"
        },
        "document_hash": {
          "type": "string",
          "description": "SHA-256 hash of the file content, used for duplicate detection"
        }
      }
    },
    "DuplicateDocumentError": {
      "type": "object",
      "properties": {
        "detail": {
          "type": "string",
          "description": "Error message"
        },
        "existing_document_id": {
          "type": "integer",
          "description": "ID of the existing duplicate document"
        },
        "original_filename": {
          "type": "string",
          "description": "Filename of the existing document"
        },
        "uploaded_at": {
          "type": "string",
          "format": "date-time",
          "description": "Upload timestamp of the existing document"
        },
        "document_hash": {
          "type": "string",
          "description": "Hash shared by both files"
        },
        "existing_document_source": {
          "type": "string",
          "enum": [
            "upload",
            "bootstrapping"
          ],
          "description": "bootstrapping when the file matches seeded historical data"
        }
      }
    },
    "ExtractionResponse": {
      "type": "object",
      "properties": {
        "extraction_id": {
          "type": "integer",
          "description": "Extraction record ID"
        },
        "extracted_data": {
          "type": "object",
          "description": "Extracted fields; structure depends on the document type"
        },
        "overall_confidence": {
          "type": "number",
          "description": "Overall extraction confidence score (0-1)"
        },
        "composite_confidence": {
          "type": "number",
          "description": "Confidence combined with validation results (0-1)"
        },
        "status": {
          "type": "string",
          "description": "Extraction status, e.g. pending_review or auto_approved"
        },
        "auto_approved": {
          "type": "boolean",
          "description": "True if the extraction met the auto-approval thresholds"
        }
      }
    },
    "MailIngestRequest": {
      "type": "object",
      "required": [
        "message_id",
        "received_at"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "description": "Stable id for this email and attachment, e.g. the email id and the attachment id joined with '/'. A repeat is ignored."
        },
        "sender_address": {
          "type": "string",
          "description": "Sender email address"
        },
        "sender_name": {
          "type": "string",
          "description": "Sender display name"
        },
        "subject": {
          "type": "string",
          "description": "Email subject"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the email was received"
        },
        "body_content": {
          "type": "string",
          "description": "Email body"
        },
        "body_content_type": {
          "type": "string",
          "enum": [
            "html",
            "text"
          ],
          "default": "html",
          "description": "Format of body_content"
        },
        "document_type": {
          "type": "string",
          "enum": [
            "order",
            "invoice",
            "data_sheet",
            "delivery_note",
            "quote_request"
          ],
          "default": "order",
          "description": "Type of document for extraction"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MailAttachment"
          },
          "description": "Attachments; the first PDF becomes the document"
        }
      }
    },
    "MailAttachment": {
      "type": "object",
      "required": [
        "name",
        "content_type",
        "content_base64"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "File name"
        },
        "content_type": {
          "type": "string",
          "description": "MIME type; send application/pdf for PDFs"
        },
        "content_base64": {
          "type": "string",
          "description": "File content, base64-encoded"
        },
        "is_inline": {
          "type": "boolean",
          "default": false,
          "description": "True for images embedded in the body"
        }
      }
    },
    "MailIngestResponse": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "integer",
          "description": "factoriq.ai message record ID"
        },
        "document_id": {
          "type": "integer",
          "description": "ID of the document created from the email"
        },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "duplicate"
          ],
          "description": "duplicate if this message_id was already received"
        },
        "sender_address": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
