{
  "swagger": "2.0",
  "info": {
    "title": "factoriq.ai Document Processing",
    "description": "Upload documents and run AI-powered data extraction via factoriq.ai",
    "version": "1.1.0",
    "contact": {
      "name": "factoriq.ai Support",
      "url": "https://inbox.factoriq.ai/docs"
    }
  },
  "host": "inbox.factoriq.ai",
  "basePath": "/api",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "apiKey": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "API key authentication. Format: Bearer idpe_<your-api-key>"
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/documents/upload": {
      "post": {
        "operationId": "UploadDocument",
        "summary": "Upload a document",
        "description": "Upload a PDF, PNG, JPEG, plain-text or HTML file. Returns a document record with an ID that is used to run extraction.",
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "file",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": "File to upload: PDF, PNG, JPEG, TXT or HTML"
          },
          {
            "name": "document_type",
            "in": "formData",
            "type": "string",
            "required": false,
            "default": "order",
            "enum": [
              "order",
              "invoice",
              "data_sheet",
              "delivery_note",
              "quote_request"
            ],
            "description": "Type of document for extraction"
          }
        ],
        "responses": {
          "200": {
            "description": "Document uploaded successfully",
            "schema": {
              "$ref": "#/definitions/DocumentResponse"
            }
          },
          "400": {
            "description": "Invalid file (unsupported type, too large, or corrupted)"
          },
          "401": {
            "description": "Invalid or expired API key"
          },
          "409": {
            "description": "Duplicate document already uploaded",
            "schema": {
              "$ref": "#/definitions/DuplicateDocumentError"
            }
          },
          "429": {
            "description": "Rate limit or monthly quota exceeded"
          }
        }
      }
    },
    "/documents/{document_id}/extract": {
      "post": {
        "operationId": "TriggerExtraction",
        "summary": "Run extraction for an uploaded document",
        "description": "Run AI-powered data extraction on a previously uploaded document. The call is synchronous: it returns once the extraction is finished, with the extracted data and confidence. If extraction fails, the document is deleted so it can be uploaded again. Do not retry this action automatically.",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "type": "integer",
            "required": true,
            "description": "ID of the document to extract (from upload response)"
          }
        ],
        "responses": {
          "200": {
            "description": "Extraction finished",
            "schema": {
              "$ref": "#/definitions/ExtractionResponse"
            }
          },
          "400": {
            "description": "Document could not be read (extraction failed; the document has been deleted)"
          },
          "401": {
            "description": "Invalid or expired API key"
          },
          "404": {
            "description": "Document not found"
          },
          "429": {
            "description": "Monthly quota exceeded"
          },
          "500": {
            "description": "Extraction failed (the document has been deleted)"
          }
        }
      }
    }
  },
  "definitions": {
    "DocumentResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Document ID (use this to trigger extraction)"
        },
        "filename": {
          "type": "string",
          "description": "Server-generated filename"
        },
        "original_filename": {
          "type": "string",
          "description": "Original filename as uploaded"
        },
        "file_size": {
          "type": "integer",
          "description": "File size in bytes"
        },
        "status": {
          "type": "string",
          "description": "Document status: uploaded, processed or extraction_failed"
        },
        "document_type": {
          "type": "string",
          "description": "Document type used for extraction"
        },
        "uploaded_at": {
          "type": "string",
          "format": "date-time",
          "description": "Upload timestamp"
        },
        "content_type": {
          "type": "string",
          "description": "MIME type of the stored file"
        },
        "document_hash": {
          "type": "string",
          "description": "SHA-256 hash of the file content, used for duplicate detection"
        }
      }
    },
    "DuplicateDocumentError": {
      "type": "object",
      "properties": {
        "detail": {
          "type": "string",
          "description": "Error message"
        },
        "existing_document_id": {
          "type": "integer",
          "description": "ID of the existing duplicate document"
        },
        "original_filename": {
          "type": "string",
          "description": "Filename of the existing document"
        },
        "uploaded_at": {
          "type": "string",
          "format": "date-time",
          "description": "Upload timestamp of the existing document"
        },
        "document_hash": {
          "type": "string",
          "description": "Hash shared by both files"
        },
        "existing_document_source": {
          "type": "string",
          "enum": [
            "upload",
            "bootstrapping"
          ],
          "description": "bootstrapping when the file matches seeded historical data"
        }
      }
    },
    "ExtractionResponse": {
      "type": "object",
      "properties": {
        "extraction_id": {
          "type": "integer",
          "description": "Extraction record ID"
        },
        "extracted_data": {
          "type": "object",
          "description": "Extracted fields; structure depends on the document type"
        },
        "overall_confidence": {
          "type": "number",
          "description": "Overall extraction confidence score (0-1)"
        },
        "composite_confidence": {
          "type": "number",
          "description": "Confidence combined with validation results (0-1)"
        },
        "status": {
          "type": "string",
          "description": "Extraction status, e.g. pending_review or auto_approved"
        },
        "auto_approved": {
          "type": "boolean",
          "description": "True if the extraction met the auto-approval thresholds"
        }
      }
    }
  }
}
